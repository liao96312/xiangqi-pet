{
  "name": "xiangqi-pet",
  "version": "1.2.0",
  "private": true,
  "description": "Desktop pet style Xiangqi trainer",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "start": "node scripts/start.cjs",
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5188\" \"wait-on tcp:5188 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5188 node scripts/start.cjs\"",
    "generate:icon": "node scripts/generate-icon.cjs",
    "check:engine": "node scripts/check-engine.cjs",
    "benchmark:engine": "tsc -p tsconfig.electron.json && node scripts/benchmark-engine.cjs",
    "capture:3d-qa": "npm run build && node scripts/capture-3d-qa.cjs",
    "capture:3d-dynamic-qa": "npm run build && node scripts/capture-3d-dynamic-qa.cjs",
    "capture:3d-fullgame-qa": "npm run build && node scripts/capture-3d-fullgame-qa.cjs",
    "audit:assets": "\"D:/Tools/Blender/blender-5.2.0-windows-x64/blender.exe\" --background --python tools/blender/generate_hy3_manifest.py -- . public/assets/HY3_RUNTIME_ASSET_MANIFEST.json HY3_ASSET_MANIFEST.md",
    "build": "tsc -p tsconfig.json && vite build && node scripts/prune-dist-assets.cjs && tsc -p tsconfig.electron.json",
    "selftest": "tsc -p tsconfig.selftest.json && node scripts/mark-selftest-commonjs.cjs && node .selftest/tests/xiangqi.selftest.js && node .selftest/tests/boardGeometry.selftest.js",
    "build:installer": "npm run generate:icon && npm run check:engine && npm run audit:assets && npm run selftest && npm run build && electron-builder --win nsis --x64",
    "preview": "npm run build && node scripts/start.cjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.3",
    "@vitejs/plugin-react": "^4.7.0",
    "7zip-bin": "^5.2.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3",
    "innoextract-bin": "^0.2.0",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.liao96312.xiangqipet",
    "productName": "象棋桌宠",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "electron/preload.cjs",
      "THIRD_PARTY_ASSETS.md",
      "HY3_ASSET_MANIFEST.md",
      "licenses/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "engines/pikafish-official",
        "to": "engines",
        "filter": [
          "pikafish*.exe",
          "*.nnue",
          "Copying.txt",
          "AUTHORS"
        ]
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "artifactName": "${productName}-Setup-${version}.${ext}"
  }
}
